# ==============================================================================
#  iRACK IT Solution — Production Environment Configuration Template
# ==============================================================================

APP_NAME="iRACK IT Solution"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=https://irack.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# High-Performance MySQL Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=irack_production
DB_USERNAME=irack_db_user
DB_PASSWORD=STRONG_PRODUCTION_PASSWORD_HERE

# Production Cache & Session (Redis recommended for enterprise scaling)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.irack.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=irack_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Corporate SMTP Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@irack.com
MAIL_PASSWORD=SECURE_SMTP_SECRET
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="sales@irack.com"
MAIL_FROM_NAME="iRACK IT Solution"

# Security & CORS
SANCTUM_STATEFUL_DOMAINS="irack.com,www.irack.com,showroom.irack.com,admin.irack.com"
CORS_ALLOWED_ORIGINS="https://irack.com,https://www.irack.com,https://showroom.irack.com,https://admin.irack.com"

# Regional Tax & Commercial Validity Baseline
IRACK_DEFAULT_TAX_RATE=15.00
IRACK_QUOTATION_VALIDITY_DAYS=30
IRACK_DEFAULT_CURRENCY=SAR
